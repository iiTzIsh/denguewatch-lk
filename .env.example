# Copy to .env. Leave values commented out to use the defaults inside the project folder.
# DW_DATA_DIR=F:/DengueWatchLK/data
# DW_LOG_DIR=F:/DengueWatchLK/logs
# DW_DB_PATH=F:/DengueWatchLK/data/denguewatch.duckdb

# Telegram weekly alert (src/alerts/telegram.py)
# Token: @BotFather /newbot. Chat id: message the bot, then read "chat":{"id": ...} from
# https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# MLflow (src/ml); defaults to the local server from `docker compose up -d mlflow`
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_DISABLE_TELEMETRY=true
